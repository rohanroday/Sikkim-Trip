# Copy to .env.local and fill in. Never commit real values.
MONGODB_URI=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SMS_PROVIDER_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SESSION_SECRET=
CRON_SECRET=
SENTRY_DSN=
ADMIN_ALERT_WHATSAPP=
# Public WhatsApp number for the support buttons (digits, with country code)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Comma-separated phone numbers allowed to sign in to /admin (e.g. +919800000000)
ADMIN_PHONES=
# true = test mode: sign-in codes shown on screen while WhatsApp is not connected.
# Ignored when RAZORPAY_KEY_ID is a live key.
NEXT_PUBLIC_TEST_MODE=
# Optional: home hero photo, e.g. /images/hero.jpg (see public/images/README.md)
NEXT_PUBLIC_HERO_IMAGE=

# Optional: short muted loop shown over the hero photo, e.g. /videos/hero.mp4
NEXT_PUBLIC_HERO_VIDEO=
